<header class="intro" id="about">

    <div class="intro-head">

        <img class="intro-photo" src="{{ personal_data['image'] }}" alt="{{ personal_data['full_name'] }}" width="128" height="128">

        <div>
            <h1 class="intro-name">{{ personal_data['full_name'] }}</h1>
            <p class="intro-title">{{ personal_data['title'] }}</p>
            <p class="intro-location">{{ personal_data['affiliation'] }} &middot; {{ personal_data['location'] }}</p>

            <ul class="intro-links">
                <li><a href="mailto:{{ personal_data['email'] }}">Email</a></li>
                {% for social_media in personal_data['social_media'] %}
                <li><a href="{{ social_media['url'] }}" target="_blank" rel="noopener">{{ social_media['name'] }}</a></li>
                {% endfor %}
            </ul>
        </div>

    </div>

    <p class="intro-bio">{{ about_me_page['description'] }}</p>

</header>
