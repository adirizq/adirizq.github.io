<section class="section" id="projects">

    <h2 class="section-title">Projects</h2>

    <ul class="projects">

        {% for portfolio in portfolio_page['portfolios'] %}
        <li class="project">

            <a class="project-thumb" href="{{ portfolio['url'] }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src="{{ portfolio['image'] }}" alt="" loading="lazy">
            </a>

            <div>
                <h3 class="project-title">
                    <a href="{{ portfolio['url'] }}" target="_blank" rel="noopener">{{ portfolio['name'] }}</a>
                </h3>
                <p class="project-desc">{{ portfolio['description'] }}</p>
                <p class="project-tech">{{ portfolio['tech_stacks'] | join(' · ') }}</p>
            </div>

        </li>
        {% endfor %}

    </ul>

</section>
